          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_games_fts_BEFORE_UPDATE BEFORE UPDATE ON `games` BEGIN DELETE FROM `games_fts` WHERE `docid`=OLD.`rowid`; END",
