          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_games_fts_AFTER_INSERT AFTER INSERT ON `games` BEGIN INSERT INTO `games_fts`(`docid`, `title`, `platform`, `genre`) VALUES (NEW.`rowid`, NEW.`title`, NEW.`platform`, NEW.`genre`); END"
